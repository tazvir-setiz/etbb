BOT_TOKEN=
# Choose one: telegram or bale. Use the token created on that platform.
BOT_PLATFORM=telegram
ADMIN_USER_IDS=
# Database configuration:
# 1) Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./survey_bot.db
# 2) Docker with volume persistence mapped to ./data:
# DATABASE_URL=sqlite+aiosqlite:////data/survey_bot.db
# 3) PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/survey_db
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
